# ---- Yahoo Fantasy (create an app at https://developer.yahoo.com/apps/create/) ----
# Application type: "Web Application", API permissions: Fantasy Sports -> Read/Write
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# "oob" lets you paste the code Yahoo shows you (easiest for running locally).
# Or use an https URL that points at /auth/callback, e.g. https://localhost:8000/auth/callback
YAHOO_REDIRECT_URI=oob
# Optional: pin a league (e.g. 461.l.123456). Otherwise pick one in the dashboard.
YAHOO_LEAGUE_KEY=

# Leave blank to auto-enable demo mode when no Yahoo credentials are set
DEMO_MODE=

# ---- Notifications (configure any combination) ----
# Phone push via the free ntfy app (https://ntfy.sh) - pick a hard-to-guess topic name
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ---- Monitoring ----
# How often the background monitor checks your team (0 disables it)
MONITOR_INTERVAL_MINUTES=60
# Alert when the recommended lineup beats your current one by this many points
LINEUP_GAIN_ALERT=2.0
# Alert on unrostered players added in at least this many leagues (Sleeper trending)
WAIVER_TREND_MIN=1500
DB_PATH=data/companion.db
